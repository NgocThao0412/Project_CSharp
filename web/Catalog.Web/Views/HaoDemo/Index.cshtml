@model System.Collections.Generic.IReadOnlyList<Catalog.Web.Features.Hao.HaoProduct>
@{
    Layout = "~/Views/Shared/_HaoLayout.cshtml";
    ViewData["Title"] = "Thử nghiệm phần Hào";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="hao-eyebrow mb-2">CHỈ DÀNH CHO DEV / DEMO</div>
        <h1 class="h2 fw-bold mb-1">Linh kiện mẫu để thử giỏ hàng</h1>
        <p class="text-secondary mb-0">Không thay thế trang sản phẩm thật do Ny phụ trách.</p>
    </div>
    <a class="btn btn-outline-primary" href="/gio-hang">Xem giỏ hàng</a>
</div>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
@foreach (var item in Model)
{
    <div class="col">
        <article class="card hao-card h-100 overflow-hidden">
            <img class="hao-product-photo" loading="lazy" src="@Catalog.Web.Features.Hao.HaoProductImages.ForDemoProduct(item.ProductId)" alt="Ảnh minh họa @item.Name" />
            <div class="card-body d-flex flex-column p-3">
                <h2 class="h6 fw-bold mb-2">@item.Name</h2>
                <div class="hao-price fw-bold fs-5 mb-1">@item.PriceVnd.ToString("N0") đ</div>
                <p class="small text-secondary mb-3">Tồn thực tế mẫu: @item.ActualStock</p>
                <form class="mt-auto" method="post" action="/gio-hang/them">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@item.ProductId" />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="returnUrl" value="/hao-demo" />
                    <button class="btn btn-primary w-100" type="submit">Thêm vào giỏ</button>
                </form>
            </div>
        </article>
    </div>
}
</div>
