@{
    Layout = "~/Views/Shared/_GiaoDienKhachHang.cshtml";
    ViewData["Title"] = "Đặt hàng thành công";
    var code = ViewBag.OrderCode as string ?? "";
    var verification = ViewBag.VerificationCode as string;
}
<div class="card kh-card kh-complete mx-auto">
    <div class="card-body p-4 p-lg-5 text-center">
        <div class="kh-success-icon mx-auto mb-3" aria-hidden="true">✓</div>
        <h1 class="h2 fw-bold mb-2">Đặt hàng thành công</h1>
        <p class="text-secondary">Đơn đang ở trạng thái <span class="badge text-bg-info">ĐANG GIỮ HÀNG</span> trong bản demo.</p>
        <div class="kh-copy-row"><span>Mã đơn hàng</span><strong class="text-break">@code</strong></div>
        @if (!string.IsNullOrEmpty(verification))
        {
            <div class="kh-copy-row"><span>Mã xác thực</span><code class="text-break">@verification</code></div>
            <div class="alert alert-warning text-start small mt-3" role="alert">Lưu lại mã đơn và mã xác thực để tra cứu hoặc hủy. Mã xác thực chỉ được hiển thị một lần và không nằm trong URL.</div>
        }
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            <a class="btn btn-primary px-4" href="/don-hang/tra-cuu">Tra cứu đơn</a>
            <a class="btn btn-outline-primary" href="/">Về trang chủ</a>
        </div>
    </div>
</div>
