<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Cửa hàng linh kiện máy tính</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="wrap header-inner">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">◈</span><span>CỬA HÀNG<br /><strong>LINH KIỆN MÁY TÍNH</strong></span></a>
        <nav aria-label="Điều hướng chính">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a asp-controller="Products" asp-action="Index">Sản phẩm</a>
            <a href="/tim-kiem">Tìm kiếm</a>
        </nav>
    </div>
</header>
<main>@RenderBody()</main>
<footer class="site-footer"><div class="wrap"></div></footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
