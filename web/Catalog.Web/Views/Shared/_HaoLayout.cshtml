@using Microsoft.AspNetCore.Authentication
@{
    var pageTitle = ViewData["Title"] as string ?? "Cửa hàng linh kiện máy tính";
    var haoTicket = await Context.AuthenticateAsync(Catalog.Web.Features.Hao.HaoAuth.Scheme);
    var haoSignedIn = haoTicket.Succeeded;
    var customerHome = Catalog.Web.Features.Hao.HaoFrontendLinks.Home(Context.Request);
    var customerProducts = Catalog.Web.Features.Hao.HaoFrontendLinks.Products(Context.Request);
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@pageTitle - Cửa hàng linh kiện máy tính</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="@Url.Content("~/css/hao-web.css")" />
</head>
<body class="hao-page d-flex flex-column min-vh-100">
<header class="hao-navbar sticky-top">
    <nav class="navbar navbar-expand-lg navbar-light py-3" aria-label="Điều hướng mua hàng">
        <div class="container">
            <a class="navbar-brand fw-bold text-wrap hao-brand" href="@customerHome"><span class="hao-brand-mark" aria-hidden="true"></span><span class="hao-brand-lines"><small>CỬA HÀNG</small><strong>LINH KIỆN MÁY TÍNH</strong></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#haoNavigation" aria-controls="haoNavigation" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="haoNavigation">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="@customerHome">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="@customerProducts">Sản phẩm</a></li>
                    <li class="nav-item"><a class="nav-link" href="/gio-hang">Giỏ hàng</a></li>
                    <li class="nav-item"><a class="nav-link" href="/don-hang/tra-cuu">Tra cứu đơn</a></li>
                    <li class="nav-item"><a class="nav-link" href="/don-hang/cua-toi">Đơn của tôi</a></li>
                    @if (haoSignedIn)
                    {
                        <li class="nav-item"><span class="navbar-text hao-account-name">@haoTicket.Principal?.Identity?.Name</span></li>
                        <li class="nav-item"><form method="post" action="/tai-khoan/dang-xuat">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-primary btn-sm ms-lg-1">Đăng xuất</button></form></li>
                    }
                    else if (pageTitle == "Đăng nhập")
                    {
                        <li class="nav-item"><a class="btn btn-outline-primary btn-sm ms-lg-1" href="/tai-khoan/dang-ky">Đăng ký</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-outline-primary btn-sm ms-lg-1" href="/tai-khoan/dang-nhap">Đăng nhập</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="hao-demo-notice text-center py-2 px-3" role="note">
    MÔ-ĐUN KIỂM THỬ RIÊNG: đơn hàng/tài khoản hiện lưu trong bộ nhớ, <strong>chưa đồng bộ SQL Server và Desktop</strong>.
</div>
<main class="container py-4 py-lg-5 flex-grow-1" id="hao-main">
    @if (TempData["HaoMessage"] is string message)
    {
        <div class="alert alert-success d-flex align-items-center" role="status">@message</div>
    }
    @if (TempData["HaoError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @RenderBody()
</main>
<footer class="hao-footer mt-auto py-4">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2 small">
        <span>© 2026 Cửa hàng linh kiện máy tính</span>
        <span>Phần Hào · ASP.NET Core MVC · Bootstrap 5</span>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
