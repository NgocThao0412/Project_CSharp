@model CatalogProduct
@{ ViewData["Title"] = Model.Name; }
<div class="wrap section">
    <div class="breadcrumb"><a href="/">Trang chủ</a> / <a href="/san-pham">Sản phẩm</a> / @Model.Name</div>
    <div class="detail-grid">
        <div class="detail-image">@if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) {<img src="@Model.ImageUrl" alt="@Model.Name" />} else {<span aria-hidden="true">PC</span>}</div>
        <div class="detail-info"><div class="eyebrow blue">@Model.Category</div><h1>@Model.Name</h1><p class="muted">Thương hiệu: @Model.Brand · Mã sản phẩm: @Model.Id</p>
            <div class="detail-price">@Model.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</div>
            <p class="stock @(Model.AvailableQuantity<=0 ? "sold-out" : "")">@(Model.AvailableQuantity>0 ? $"Đang có {Model.AvailableQuantity} sản phẩm khả dụng" : "Sản phẩm tạm hết hàng")</p>
            <h2>Mô tả sản phẩm</h2><p>@Model.Description</p>
            <a class="primary-link" href="/san-pham">← Tiếp tục xem sản phẩm</a>
            <p class="integration-note">Chức năng giỏ hàng và đặt hàng được tích hợp riêng từ phần của Hào. Không tự động trừ số lượng khi chỉ xem sản phẩm.</p>
        </div>
    </div>
</div>
