@model IReadOnlyList<CatalogProduct>
@{ ViewData["Title"] = "Trang chủ"; }
<section class="hero">
    <div class="wrap hero-grid">
        <div>
            <span class="eyebrow">LINH KIỆN MÁY TÍNH</span>
            <h1>Chọn linh kiện phù hợp với nhu cầu của bạn.</h1>
            <p>Tìm kiếm, tham khảo sản phẩm và xem thông tin tồn khả dụng trước khi đặt hàng.</p>
            <form method="get" action="/tim-kiem" class="hero-search">
                <input name="q" maxlength="100" placeholder="Tìm CPU, RAM, SSD..." aria-label="Từ khóa tìm kiếm" />
                <button type="submit">Tìm sản phẩm</button>
            </form>
        </div>
        <div class="hero-visual" aria-hidden="true"><div class="chip">CPU</div><div class="chip secondary">RAM</div><div class="chip third">SSD</div></div>
    </div>
</section>
<section class="wrap section">
    <div class="section-heading"><div><span class="eyebrow blue">KHÁM PHÁ</span><h2>Sản phẩm nổi bật</h2></div><a href="/san-pham">Xem tất cả →</a></div>
    <div class="product-grid">@foreach (var item in Model) { <partial name="_ProductCard" model="item" /> }</div>
</section>
